#!/usr/bin/env python3
"""Open one Windows Terminal tab per recorded live Codex/Claude session."""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

from agent_session_filters import (
    CodexSessionResolver, codex_process_paths, codex_session_id,
    is_child_session, is_guardian_session,
)


HOME = Path.home()
DEFAULT_TSV = HOME / ".agent_sessions" / "live_sessions.tsv"
DEFAULT_HISTORY = HOME / ".agent_sessions" / "live_sessions_history.jsonl"
CODEX_SESSIONS = HOME / ".codex" / "sessions"


def default_codex_bin() -> str:
    wrapper = shutil.which("codex")
    if not wrapper:
        return "codex"
    try:
        real = Path(wrapper).resolve()
    except OSError:
        return wrapper
    roots: list[Path] = []
    if real.name == "codex.js":
        roots.append(real.parent.parent)
    roots.append(real.parent.parent / "lib" / "node_modules" / "@openai" / "codex")
    for root in roots:
        for candidate in sorted(root.glob("node_modules/@openai/codex-linux-*/vendor/*/bin/codex")):
            if candidate.exists():
                return str(candidate)
    return wrapper


def read_sessions(path: Path) -> list[dict[str, str]]:
    if not path.exists():
        raise SystemExit(f"missing session snapshot: {path}")
    with path.open("r", encoding="utf-8", newline="") as handle:
        return [row for row in csv.DictReader(handle, delimiter="\t") if row.get("session_id")]


def parse_timestamp(value: str) -> dt.datetime:
    try:
        if isinstance(value, str):
            stamp = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
            if stamp.tzinfo is not None:
                return stamp
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("use an ISO timestamp with a timezone, e.g. 2026-11-10T11:25:01-05:00")


def read_history(path: Path, at: dt.datetime) -> list[dict[str, str]]:
    """Select one complete historical snapshot, without merging closed sessions."""
    selected = None
    latest = None
    try:
        with path.open(encoding="utf-8") as handle:
            for line in handle:
                try:
                    record = json.loads(line)
                    stamp = parse_timestamp(record["scanned_at"])
                    rows = record["sessions"]
                    if not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows):
                        continue
                except (ValueError, KeyError, TypeError, argparse.ArgumentTypeError):
                    continue
                if stamp <= at and (latest is None or stamp >= latest):
                    latest, selected = stamp, rows
    except OSError as exc:
        raise SystemExit(f"cannot read session history {path}: {exc}") from exc
    if selected is None:
        raise SystemExit(f"no historical snapshot at or before {at.isoformat()}")
    print(f"Using snapshot from {latest.isoformat()}", file=sys.stderr)
    return [row for row in selected if row.get("session_id")]


def run(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, capture_output=True, check=False)


def live_session_ids() -> set[str]:
    ids: set[str] = set()
    resolver = CodexSessionResolver(CODEX_SESSIONS)

    codex_pids = run(["pgrep", "-x", "codex"])
    if codex_pids.returncode in (0, 1):
        for line in codex_pids.stdout.splitlines():
            pid = line.strip()
            if not pid:
                continue
            lsof = run(["lsof", "-Fn", "-p", pid])
            names = [line[1:] for line in lsof.stdout.splitlines() if line.startswith("n")]
            for path in codex_process_paths(int(pid), names, resolver):
                session_id = codex_session_id(path)
                if not session_id:
                    continue
                ids.add(session_id)
                root = resolver.root_session({
                    "tool": "codex", "session_id": session_id,
                    "session_path": path,
                })
                if root is not None:
                    ids.add(root["session_id"].lower())

    claude_dir = HOME / ".claude" / "sessions"
    if claude_dir.exists():
        for path in claude_dir.glob("*.json"):
            try:
                data = __import__("json").loads(path.read_text(encoding="utf-8"))
            except Exception:
                continue
            pid = data.get("pid")
            session_id = data.get("sessionId")
            if isinstance(pid, int) and session_id and (Path("/proc") / str(pid)).exists():
                ids.add(str(session_id).lower())

    return ids


def skip_reason(row: dict[str, str]) -> str:
    # Check the header as well as saved metadata to protect older snapshots.
    # --force only overrides the already-live check, never this exclusion.
    if is_guardian_session(row):
        return "Guardian review"
    if is_child_session(row):
        return "child agent"
    if row.get("recoverable") == "no":
        return "non-recoverable"
    if row.get("tool") == "claude" and "/.claude/sessions/" in row.get("session_path", ""):
        return "non-recoverable"
    return "" if row.get("session_id") else "non-recoverable"


def is_recoverable(row: dict[str, str]) -> bool:
    return not skip_reason(row)


def select_sessions(
    rows: list[dict[str, str]],
) -> tuple[list[dict[str, str]], list[tuple[dict[str, str], str]]]:
    resolver = CodexSessionResolver(CODEX_SESSIONS, rows)
    selected: dict[tuple[str, str], dict[str, str]] = {}
    skipped: list[tuple[dict[str, str], str]] = []
    for row in rows:
        # Normalize IDs and directories in old snapshots as well as new ones.
        original = row
        reason = skip_reason(row)
        if reason == "child agent":
            root = resolver.root_session(row)
            if root is None:
                skipped.append((row, "child agent (parent unavailable or invalid)"))
                continue
            skipped.append((row, f"child agent (using parent {root['session_id']})"))
            if not skip_reason(root):
                key = (root.get("tool", ""), root["session_id"].lower())
                selected.setdefault(key, root)
        elif reason:
            skipped.append((row, reason))
        else:
            row = resolver.root_session(row)
            if row is None:
                skipped.append((original, "parent unavailable or invalid"))
                continue
            # Prefer a recorded parent row over one synthesized from a child.
            key = (row.get("tool", ""), row["session_id"].lower())
            selected[key] = row
    return list(selected.values()), skipped


def tool_command(row: dict[str, str], executables: dict[str, str]) -> str:
    tool = row.get("tool", "")
    session_id = row.get("session_id", "")
    if tool == "codex":
        return f"{shlex.quote(executables['codex'])} resume {shlex.quote(session_id)}"
    if tool == "claude":
        return f"{shlex.quote(executables['claude'])} --resume {shlex.quote(session_id)}"
    raise ValueError(f"unsupported tool {tool!r}")


def title_for(row: dict[str, str]) -> str:
    tool = row.get("tool", "agent")
    name = row.get("name") or Path(row.get("cwd", "")).name or row.get("session_id", "")[:8]
    return f"{tool}: {name}"


def build_wt_command(
    row: dict[str, str],
    distro: str,
    window: str,
    keep_shell: bool,
    executables: dict[str, str],
) -> list[str]:
    cwd = row.get("cwd") or str(HOME)
    resume_cmd = tool_command(row, executables)
    shell_cmd = resume_cmd
    if keep_shell:
        # Windows Terminal treats unescaped semicolons as command separators,
        # even when they are meant for bash -lc. Keep this payload semicolon-free.
        shell_cmd = f"{resume_cmd} || true && exec bash -l"
    return [
        "wt.exe",
        "-w",
        window,
        "new-tab",
        "--title",
        title_for(row),
        "wsl.exe",
        "-d",
        distro,
        "--cd",
        cwd,
        "--",
        "bash",
        "-lc",
        shell_cmd,
    ]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--snapshot", type=Path, help=f"session TSV to restore; default: {DEFAULT_TSV}")
    source.add_argument("--at", type=parse_timestamp, help="restore the last history snapshot at or before this ISO timestamp (include timezone)")
    parser.add_argument("--history", type=Path, default=DEFAULT_HISTORY, help="JSONL history used with --at")
    parser.add_argument("--distro", default=os.environ.get("WSL_DISTRO_NAME", "Ubuntu-22.04"), help="WSL distro name for wsl.exe -d")
    parser.add_argument("--window", default="0", help="Windows Terminal window target for wt.exe -w; default: 0")
    parser.add_argument("--tool", choices=["codex", "claude"], action="append", help="restore only this tool; repeatable")
    parser.add_argument("--limit", type=int, default=0, help="restore at most N sessions")
    parser.add_argument("--dry-run", action="store_true", help="print wt.exe commands without opening tabs")
    parser.add_argument("--force", action="store_true", help="restore sessions even if they appear to be live already")
    parser.add_argument("--close-tab-on-exit", action="store_true", help="do not keep a login shell after Codex/Claude exits")
    parser.add_argument("--codex-bin", default=default_codex_bin(), help="Codex executable path for launched tabs")
    parser.add_argument("--claude-bin", default=shutil.which("claude") or "claude", help="Claude executable path for launched tabs")
    args = parser.parse_args()

    recorded = read_history(args.history, args.at) if args.at else read_sessions(args.snapshot or DEFAULT_TSV)
    rows, skipped = select_sessions(recorded)
    already_live: list[dict[str, str]] = []
    if not args.force:
        live_ids = live_session_ids()
        already_live = [row for row in rows if row.get("session_id", "").lower() in live_ids]
        rows = [row for row in rows if row.get("session_id", "").lower() not in live_ids]
    if args.tool:
        allowed = set(args.tool)
        rows = [row for row in rows if row.get("tool") in allowed]
    if args.limit > 0:
        rows = rows[: args.limit]
    if not rows:
        for row, reason in skipped:
            print(f"skip {reason} {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
        for row in already_live:
            print(f"skip already-live {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
        raise SystemExit("no sessions selected to restore")

    executables = {"codex": args.codex_bin, "claude": args.claude_bin}
    commands = [
        build_wt_command(row, args.distro, args.window, keep_shell=not args.close_tab_on_exit, executables=executables)
        for row in rows
    ]
    if args.dry_run:
        for row, reason in skipped:
            print(f"skip {reason} {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
        for row in already_live:
            print(f"skip already-live {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
        for command in commands:
            print(shlex.join(command))
        return 0

    for row, reason in skipped:
        print(f"Skipping {reason} {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
    for row in already_live:
        print(f"Skipping already-live {row.get('tool')} session {row.get('session_id')}", file=sys.stderr)
    for command in commands:
        try:
            subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )
        except OSError as exc:
            print(f"failed to launch {shlex.join(command)}: {exc}", file=sys.stderr)
            return 1
    print(f"Opened {len(commands)} Windows Terminal tab(s).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
